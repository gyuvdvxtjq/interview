};
$('repRetry').onclick = () => {
  if (!ws || ws.readyState !== 1) { toast('连接已断开，请刷新页面'); return; }
  startSkeleton();
  ws.send(JSON.stringify({ type: 'gen_report' }));
};

/* ================= 报告等待态 ================= */
function startSkeleton() {
  show('view-report');
  window.scrollTo(0, 0);
  $('repHead').style.display = 'none';
  $('repBody').innerHTML = '';
  $('repSkel').classList.remove('hidden');
  $('repBtns').classList.add('hidden');
  $('repRetry').style.display = 'none';
  $('repWait').classList.add('on');
  setState('正在复盘…', 'thinking');
  clearInterval(repInt);
  repT0 = Date.now();
  const tick = () => { $('repWaitText').textContent = 'AI 正在复盘这场面试… ' + Math.floor((Date.now() - repT0) / 1000) + 's'; };
  tick();
  repInt = setInterval(tick, 1000);
}
function failSkeleton() {
  clearInterval(repInt);
  $('repSkel').classList.add('hidden');
  $('repWait').classList.remove('on');
  $('repBody').innerHTML = '<p style="color:var(--err);margin:6px 0">报告生成失败，可以点下方按钮重试；转写记录仍保留在上方「展开完整转写」里。</p>';
  $('repBtns').classList.remove('hidden');
  $('repRetry').style.display = 'inline-block';
}

/* ================= 报告 ================= */
let reportMd = '';
function showReport(m) {
  reportMd = m.markdown;
  clearInterval(timerInt);
  clearInterval(repInt);
  $('repWait').classList.remove('on');
  $('repSkel').classList.add('hidden');
  $('repBtns').classList.remove('hidden');
  $('repRetry').style.display = 'none';
  // 解析分数行
  let total = null; const dims = [];
  const lines = (m.markdown || '').split('\n');
  const restLines = [];
  for (const ln of lines) {
    const tm = ln.match(/总分[：:]\s*(\d{1,3})\s*\/?\s*100?/i);
    const dm = [...ln.matchAll(/([\u4e00-\u9fa5A-Za-z ]{2,10})[：:]\s*(\d{1,3})\s*\/?\s*100/g)];
    if (tm) total = +tm[1];
    else if (dm.length && !ln.includes('总分')) dm.forEach((d) => dims.push([d[1].trim(), +d[2]]));
    else restLines.push(ln);
  }
  const bodyMd = restLines.join('\n');
  if (total != null || dims.length) {
    $('repHead').style.display = 'flex';
    if (total != null) {
      $('ringNum').textContent = total;
      const c = 2 * Math.PI * 52;
      setTimeout(() => { $('ringBar').style.strokeDashoffset = c * (1 - total / 100); }, 60);
    }
    $('dims').innerHTML = dims.map(([k, v]) =>
      `<div class="dim"><div class="dl"><span>${esc(k)}</span><b>${v}</b></div><div class="bar"><i data-w="${v}"></i></div></div>`).join('');
    setTimeout(() => document.querySelectorAll('.dim .bar i').forEach((i) => (i.style.width = i.dataset.w + '%')), 120);
    const prev = loadHist()[0];
    const delta = (total != null && prev && prev.total != null) ? total - prev.total : null;
    if (delta != null) {
      $('ringTag').style.display = '';
      $('ringTag').textContent = '比上一场 ' + (delta >= 0 ? '+' : '') + delta;
    } else {
      $('ringTag').style.display = 'none';
    }
    saveHist({
      ts: Date.now(), total,
      position: sessionInfo?.position || $('position').value || '',
      mode: sessionInfo?.mode || selectedMode(),
      dur: t0 ? Math.floor((Date.now() - t0) / 1000) : null,
    });
  }
  $('repBody').innerHTML = mdParse(bodyMd);
  $('trRev').innerHTML = '<h2 style="font-size:15px;color:var(--acc);margin-bottom:10px">完整转写</h2>' +
    messages.map((x) => `<p style="margin:8px 0"><b style="color:${x.role === 'ai' ? 'var(--acc)' : 'var(--ok)'}">${x.role === 'ai' ? '面试官' : '你'}：</b>${esc(x.text)}</p>`).join('');
  // 解锁弹药
  const lock = $('ammoLock'); if (lock) lock.style.display = 'none';
  const ab = $('ammoBody'); if (ab) ab.classList.remove('locked');
  $('askCard').style.display = '';
  show('view-report');
  window.scrollTo(0, 0);
}
$('trBtn').onclick = () => $('trRev').classList.toggle('hidden');
$('againBtn').onclick = () => location.href = location.pathname;
$('dlBtn').onclick = () => {
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([reportMd], { type: 'text/markdown' }));
  a.download = 'mock-interview-report.md'; a.click();
};
$('cpBtn').onclick = () => { navigator.clipboard.writeText(reportMd); toast('已复制到剪贴板'); };

/* ================= 面试后答疑 ================= */
let askBusy = false;
function askItem(kind, text) {
  const div = document.createElement('div');
  div.className = 'askItem';
  const d = document.createElement('div');
  d.className = kind === 'q' ? 'askQ' : 'askA';
  if (kind === 'q') d.textContent = text;
  div.appendChild(d);
  $('askList').appendChild(div);
  return d;
}
async function askQuestion() {
  const q = $('askInput').value.trim();
  if (!q) return;
  if (askBusy) { toast('上一个问题还在答，稍等'); return; }
  if (!sid) return;
  askBusy = true;
  $('askBtn').disabled = true;
  $('askInput').value = '';
  askItem('q', q);
  const bubble = askItem('a', '导师正在翻代码…');
  bubble.style.color = 'var(--dim)';
  try {
    const res = await fetch('/api/ask', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ sid, question: q }) });
    const j = await res.json();
    if (!res.ok) throw new Error(j.error || '请求失败');
    bubble.style.color = '';
    bubble.innerHTML = mdParse(j.answer || '（没有返回内容）');
  } catch (e) {
    bubble.style.color = 'var(--err)';
    bubble.textContent = '❌ ' + e.message;
  } finally {
    askBusy = false;
    $('askBtn').disabled = false;
    bubble.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }
}
$('askBtn').onclick = askQuestion;
$('askInput').addEventListener('keydown', (e) => { if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); askQuestion(); } });

/* ================= markdown（CDN 优先，轻量兜底） ================= */
function mdParse(md) {
  // 中文紧贴 **粗体** 时 CommonMark 不认右侧定界符，先转成内联 HTML 再交给 marked
  md = String(md).replace(/[*]{2}(.+?)[*]{2}/g, '<b>$1</b>');
  try { if (window.marked && typeof window.marked.parse === 'function') return window.marked.parse(md); } catch {}
  return esc(md)
    .replace(/^### (.*)$/gm, '<h3>$1</h3>').replace(/^## (.*)$/gm, '<h2>$1</h2>').replace(/^# (.*)$/gm, '<h1>$1</h1>')
    .replace(/^\s*[-*] (.*)$/gm, '<li>$1</li>')
    .replace(/\*\*(.+?)\*\*/g, '<b>$1</b>')
    .replace(/\n{2,}/g, '<br><br>').replace(/\n/g, '<br>');
}

