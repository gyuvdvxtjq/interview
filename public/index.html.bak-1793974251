<script>
/* ================= 基础 ================= */
const $ = (id) => document.getElementById(id);
const show = (v) => { document.querySelectorAll('.view').forEach(e => e.classList.remove('active')); $(v).classList.add('active'); };
let ws = null, sid = null, sessionInfo = null;
let audioCtx = null, mediaStream = null, workletNode = null, srcNode = null, masterGain = null;
let micOn = true, timerInt = null, t0 = 0;
let countInt = null, countEnd = 0, maxMinutes = 15, timeUp = false;
let volume = 1, curDeviceId = '';
let repT0 = 0, repInt = null, lastScore = null;
let engine = 'cascade'; // live | cascade
let liveNext = 0; const liveSrc = [];
const playQueue = []; let playing = false, curSources = [];
let lastAIBubble = null, pendingAI = null, msgCount = 0;
let curStatus = '';
const messages = []; // {role, text}
const vad = { noise: 300, speech: 0, silence: 0, inUtt: false, uttFrames: 0, barge: 0 };

/* ================= Setup 交互 ================= */
$('drop').onclick = () => $('resumeFile').click();
$('drop').ondragover = (e) => { e.preventDefault(); $('drop').classList.add('over'); };
$('drop').ondragleave = () => $('drop').classList.remove('over');
$('drop').ondrop = (e) => { e.preventDefault(); $('drop').classList.remove('over'); if (e.dataTransfer.files[0]) pickFile(e.dataTransfer.files[0]); };
$('resumeFile').onchange = (e) => { if (e.target.files[0]) pickFile(e.target.files[0]); };
function pickFile(f) {
  $('resumeFile').files = new DataTransfer().files; // 清旧
  const dt = new DataTransfer(); dt.items.add(f); $('resumeFile').files = dt.files;
  $('dropOk').textContent = '✓ ' + f.name; $('dropOk').classList.remove('hidden');
}
document.querySelectorAll('.mode').forEach(m => m.onclick = () => {
  document.querySelectorAll('.mode').forEach(x => x.classList.remove('sel'));
  m.classList.add('sel');
});
function selectedMode() { return document.querySelector('.mode.sel').dataset.mode; }
document.querySelectorAll('.style').forEach(m => m.onclick = () => {
  document.querySelectorAll('.style').forEach(x => x.classList.remove('sel'));
  m.classList.add('sel');
});
function selectedStyle() { const el = document.querySelector('.style.sel'); return el ? el.dataset.style : 'real'; }

$('startBtn').onclick = async () => {
  const btn = $('startBtn'), err = $('prepErr');
  btn.disabled = true; err.textContent = '';
  try {
    const payload = { position: $('position').value.trim(), jd: $('jd').value.trim(), mode: selectedMode(), style: selectedStyle(), githubUrl: $('ghUrl').value.trim() };
    const f = $('resumeFile').files[0];
    if (f) { payload.resumeBase64 = await fileToB64(f); payload.resumeName = f.name; }
    if (!payload.resumeBase64 && !payload.githubUrl) throw new Error('至少上传简历或填写 GitHub 仓库');
    // 步骤动画
    $('prepSteps').style.display = 'block';
    const steps = [...document.querySelectorAll('.step')];
    steps.forEach(s => s.classList.remove('doing', 'done'));
    let si = 0; steps[0].classList.add('doing');
    const adv = setInterval(() => {
      if (si < 2) { steps[si].classList.remove('doing'); steps[si].classList.add('done'); si++; steps[si].classList.add('doing'); }
    }, 9000);
    const res = await fetch('/api/prepare', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    const j = await res.json();
    clearInterval(adv);
    if (!res.ok) throw new Error(j.error || '准备失败');
    steps.forEach((s, i) => { s.classList.remove('doing'); if (i < 3) s.classList.add('done'); });
    sid = j.sid;
    steps[3].classList.add('done');
    setTimeout(() => enterRoom(), 350);
  } catch (e) {
    $('prepSteps').style.display = 'none';
    err.textContent = '❌ ' + e.message;
    btn.disabled = false;
  }
};

function fileToB64(f) {
  return new Promise((resolve, reject) => { const r = new FileReader(); r.onload = () => resolve(r.result.split(',')[1]); r.onerror = reject; r.readAsDataURL(f); });
}

/* ================= 进房 ================= */
async function enterRoom() {
  show('view-room');
  $('topPos').textContent = sessionInfo?.position || $('position').value || '模拟面试';
  const st = sessionInfo?.style || selectedStyle();
  $('topMode').textContent = ((sessionInfo?.mode || selectedMode()) === 'project' ? '项目深挖' : '综合技术面') + (st === 'code' ? ' · 代码深挖' : ' · 真实面试');
  t0 = Date.now();
  timerInt = setInterval(() => {
    const s = Math.floor((Date.now() - t0) / 1000);
    $('timer').textContent = String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0');
  }, 500);
  startCountdown(maxMinutes);
  if (window.innerWidth <= 1020) { document.querySelector('.profCol').classList.add('profFolded'); $('profFold').textContent = '展开'; }
  try { await initAudio(curDeviceId); } catch (e) { toast('🎤 麦克风初始化失败：' + e.message + '（可用文字输入继续）'); }
  connectWS();
}

async function initAudio(deviceId) {
  if (!audioCtx) {
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    masterGain = audioCtx.createGain();
    masterGain.gain.value = volume;
    masterGain.connect(audioCtx.destination);
    await audioCtx.audioWorklet.addModule(await workletUrl());
  }
  await audioCtx.resume();
  await openMic(deviceId);
  listMics();
}

async function workletUrl() {
  const workletCode = `
    class PC extends AudioWorkletProcessor {
      constructor(){ super(); this.ratio = Math.max(1, Math.round(sampleRate/16000)); this.acc=[]; this.tick=0; this.sq=0; this.n=0; }
      process(inputs){
        const ch = inputs[0] && inputs[0][0];
        if(!ch) return true;
        for(let i=0;i<ch.length;i++){
          const v = ch[i];
          this.sq += v*v; this.n++;
          if(this.tick % this.ratio === 0) this.acc.push(Math.max(-32768, Math.min(32767, v*32767)));
          this.tick++;
          if(this.acc.length >= 1600){
            const pcm = new Int16Array(this.acc);
            const level = Math.sqrt(this.sq/Math.max(1,this.n));
            this.port.postMessage({pcm, level}, [pcm.buffer]);
            this.acc=[]; this.sq=0; this.n=0;
          }
        }
        return true;
      }
    }
    registerProcessor('pcm-capture', PC);
  `;
  return URL.createObjectURL(new Blob([workletCode], { type: 'application/javascript' }));
}

async function openMic(deviceId) {
  if (mediaStream) { mediaStream.getTracks().forEach((t) => t.stop()); mediaStream = null; }
  if (srcNode) { try { srcNode.disconnect(); } catch {} srcNode = null; }
  if (workletNode) { try { workletNode.disconnect(); } catch {} workletNode = null; }
  const audio = { echoCancellation: true, noiseSuppression: true, autoGainControl: true, channelCount: 1 };
  if (deviceId) audio.deviceId = { exact: deviceId };
  mediaStream = await navigator.mediaDevices.getUserMedia({ audio });
  mediaStream.getAudioTracks().forEach((t) => (t.enabled = micOn));
  srcNode = audioCtx.createMediaStreamSource(mediaStream);
  workletNode = new AudioWorkletNode(audioCtx, 'pcm-capture');
  workletNode.port.onmessage = (e) => handleAudioFrame(e.data);
  srcNode.connect(workletNode);
}

async function listMics() {
  try {
    const all = await navigator.mediaDevices.enumerateDevices();
    const ins = all.filter((d) => d.kind === 'audioinput');
    $('micSel').innerHTML = '<option value="">默认设备</option>' +
      ins.map((d, i) => '<option value="' + d.deviceId + '">' + esc(d.label || '麦克风 ' + (i + 1)) + '</option>').join('');
    $('micSel').value = curDeviceId;
  } catch {}
}

/* ================= 倒计时 / 设置 / 滚动 ================= */
function startCountdown(min) {
  maxMinutes = Math.max(1, Number(min) || 15);
  countEnd = Date.now() + maxMinutes * 60000;
  clearInterval(countInt);
  const tick = () => {
    const left = Math.max(0, countEnd - Date.now());
    const s = Math.ceil(left / 1000);
    const mmss = String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0');
    $('count').textContent = left > 0 ? (window.innerWidth <= 720 ? mmss : '剩余 ' + mmss) : '时间到';
    $('count').classList.toggle('warn', left > 0 && left <= 3 * 60000);
  };
  tick();
  countInt = setInterval(tick, 500);
}
let stickBottom = true;
function atBottom() {
  const t = $('transcript');
  return t.scrollHeight - t.scrollTop - t.clientHeight < 80;
}
function autoScroll() {
  const t = $('transcript');
  if (stickBottom) t.scrollTop = t.scrollHeight;
}
$('transcript').addEventListener('scroll', () => {
  stickBottom = atBottom();
  $('jumpBottom').classList.toggle('on', !stickBottom);
});
$('jumpBottom').onclick = () => {
  const t = $('transcript');
  t.scrollTop = t.scrollHeight;
  stickBottom = true;
  $('jumpBottom').classList.remove('on');
};

/* ================= 设置面板 / 折叠 ================= */
$('setBtn').onclick = (e) => {
  e.stopPropagation();
  $('setPop').classList.toggle('on');
  if ($('setPop').classList.contains('on')) listMics();
};
document.addEventListener('click', (e) => {
  if (!$('setPop').contains(e.target) && e.target !== $('setBtn')) $('setPop').classList.remove('on');
});
$('micSel').onchange = async () => {
  const id = $('micSel').value;
  try { await openMic(id); curDeviceId = id; localStorage.setItem('mi_mic', id); toast('已切换麦克风'); }
  catch (e) { toast('切换失败：' + e.message); $('micSel').value = curDeviceId; }
};
$('vol').oninput = () => {
  volume = Number($('vol').value) / 100;
  if (masterGain) masterGain.gain.value = volume;
  $('volVal').textContent = $('vol').value + '%';
  localStorage.setItem('mi_vol', String(volume));
};
$('profFold').onclick = (e) => {
  e.stopPropagation();
  const c = document.querySelector('.profCol');
  c.classList.toggle('profFolded');
  $('profFold').textContent = c.classList.contains('profFolded') ? '展开' : '收起';
};
document.querySelector('.profHead').addEventListener('click', (e) => {
  if (window.innerWidth <= 1020 && e.target.className !== 'profFold') $('profFold').click();
});

/* ================= 训练记录（本机） ================= */
const HIST_KEY = 'mi_history_v1';
function loadHist() {
  try { const a = JSON.parse(localStorage.getItem(HIST_KEY) || '[]'); return Array.isArray(a) ? a : []; } catch { return []; }
}
function saveHist(rec) {
  const a = loadHist();
  a.unshift(rec);
  try { localStorage.setItem(HIST_KEY, JSON.stringify(a.slice(0, 20))); } catch {}
  renderHist();
}
function renderHist() {
  const a = loadHist();
  const box = $('history');
  if (!a.length) { box.classList.remove('on'); box.innerHTML = ''; return; }
  const rows = a.slice(0, 5).map((r, i) => {
    const prev = a[i + 1];
    const d = prev && prev.total != null && r.total != null ? r.total - prev.total : null;
    const dt = new Date(r.ts || Date.now());
    const when = (dt.getMonth() + 1) + '/' + dt.getDate() + ' ' +
      String(dt.getHours()).padStart(2, '0') + ':' + String(dt.getMinutes()).padStart(2, '0');
    return '<div class="histRow"><span style="min-width:64px">' + when + '</span>' +
      '<span style="color:var(--text);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + esc(r.position || '未填岗位') + '</span>' +
      '<div class="histBar"><i style="width:' + Math.max(0, Math.min(100, r.total || 0)) + '%"></i></div>' +
      '<b>' + (r.total == null ? '–' : r.total) + '</b>' +
      (d == null ? '' : '<span class="delta ' + (d >= 0 ? 'up' : 'down') + '">' + (d >= 0 ? '+' : '') + d + '</span>') +
      '</div>';
  }).join('');
  box.innerHTML = '<div class="histCard"><div class="histHead">训练记录 <span>最近 ' + Math.min(5, a.length) + ' 场 · 只存本机</span></div>' + rows + '</div>';
  box.classList.add('on');
}

/* ================= WS ================= */
function connectWS() {
  const proto = location.protocol === 'https:' ? 'wss://' : 'ws://';
  ws = new WebSocket(proto + location.host + '/ws');
  ws.binaryType = 'arraybuffer';
  ws.onopen = () => ws.send(JSON.stringify({ type: 'init', sid }));
  ws.onclose = () => { if (!$('view-report').classList.contains('active')) toast('连接断开，请刷新页面'); };
  ws.onerror = () => {};
  ws.onmessage = (ev) => {
    if (typeof ev.data !== 'string') return;
    const m = JSON.parse(ev.data);
    switch (m.type) {
      case 'ready':
        setState('连接引擎中…', 'thinking');
        if (m.minutes) startCountdown(m.minutes);
        loadSessionInfo();
        break;
      case 'engine':
        engine = m.engine;
        if (engine === 'live') { setState('实时连线 · 请讲', 'listening'); toast('⚡ Gemini Live 实时引擎已接入'); }
        else { toast('Live 引擎不可用，已切换级联模式'); setState('听你说', 'listening'); }
        break;
      case 'add_transcript': addMsg(m.role, m.text, m.insertBeforeAi); break;
      case 'sentence': onSentence(m); break;
      case 'reply_end': pendingAI = null; break;
      case 'live_audio': playLiveChunk(m.audio); break;
      case 'ai_delta': onAiDelta(m.text); break;
      case 'turn_end':
        pendingAI = null;
        setState('听你说', 'listening');
        break;
      case 'interrupted':
        stopLivePlayback(); pendingAI = null;
        addMsg('sys', '— 你打断了面试官 —');
        setState('你打断了面试官，请讲', 'listening');
        break;
      case 'status':
        curStatus = m.text || '';
        if (curStatus.includes('复盘')) startSkeleton();
        if (curStatus) setState(curStatus, 'thinking');
        else if (!playing && playQueue.length === 0 && !liveSrc.length) setState('听你说', 'listening');
        break;
      case 'error': toast('⚠️ ' + m.text); break;
      case 'timeup':
        timeUp = true;
        clearInterval(countInt);
        $('count').textContent = '时间到';
        $('count').classList.add('warn');
        $('endBtn').disabled = true;
        setState('面试结束，正在收尾…', 'thinking');
        addMsg('sys', '— 面试时长已到 —');
        toast('⏰ 面试时长已到，面试官道别后生成报告');
        break;
      case 'report_failed': failSkeleton(); break;
      case 'report': showReport(m); break;
    }
  };
}

async function loadSessionInfo() {
  try {
    const r = await fetch('/api/session/' + sid);
    sessionInfo = await r.json();
  } catch { return; }
  if (!sessionInfo || sessionInfo.error) return;
  const d = sessionInfo.dossier;
  $('profSub').textContent = (sessionInfo.position || '') + ' · ' + (sessionInfo.mode === 'project' ? '项目深挖' : '综合面');
  const badges = [];
