  if (sessionInfo.githubRepo) badges.push('⚡ ' + sessionInfo.githubRepo, '代码已通读');
  badges.push(sessionInfo.mode === 'project' ? '项目深挖专场' : '综合技术面');
  badges.push(sessionInfo.style === 'code' ? '代码深挖' : '真实面试');
  $('profBadges').innerHTML = badges.map((b, i) => `<div class="badge${i > 0 ? ' acc' : ''}">${b}</div>`).join('');
  if (d) {
    $('secSummary').style.display = ''; $('profSummary').textContent = d.projectSummary || '';
    if (d.highlights?.length) { $('secHi').style.display = ''; $('profHi').innerHTML = d.highlights.map((h) => `<li>${esc(h)}</li>`).join(''); }
    const ammo = [...(d.deepDive || []).map((x) => '❓ ' + x.q), ...(d.traps || []).map((x) => '🎯 ' + x)];
    if (ammo.length) { $('secAmmo').style.display = ''; $('profAmmo').innerHTML = ammo.map((a) => `<li>${esc(a)}</li>`).join(''); }
  }
  $('ivRole').textContent = (sessionInfo.position || '') + ' 面试官';
}
const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/* ================= 转写 / 状态 ================= */
function addMsg(role, text, insertBeforeAi) {
  const t = $('transcript');
  const div = document.createElement('div');
  if (role === 'sys') { div.className = 'msg sys'; div.textContent = text; }
  else {
    div.className = 'msg ' + role;
    const who = document.createElement('span'); who.className = 'who';
    who.textContent = (role === 'ai' ? '面试官' : '你') + ' · ' + new Date().toLocaleTimeString('zh-CN', { hour12: false });
    const body = document.createElement('span'); body.className = 'body'; body.textContent = text || '';
    div.appendChild(who); div.appendChild(body);
    div._body = text || '';
  }
  if (insertBeforeAi && lastAIBubble && lastAIBubble.parentNode === t) t.insertBefore(div, lastAIBubble);
  else t.appendChild(div);
  autoScroll();
  if (role === 'ai' && text) lastAIBubble = div; // 开场白经 add_transcript 建泡，登记以便 sentence 去重
  if (role !== 'sys') { messages.push({ role, text }); msgCount = messages.length; $('trCount').textContent = msgCount ? msgCount + ' 条' : ''; }
  return div;
}
function onSentence(m) {
  if (!pendingAI && lastAIBubble && lastAIBubble._body.trim() === m.text.trim()) {
    pendingAI = lastAIBubble; playSentence(m.audio, m.text); return;
  }
  if (!pendingAI) pendingAI = addMsg('ai', '');
  pendingAI._body = (pendingAI._body ? pendingAI._body + ' ' : '') + m.text;
  pendingAI.querySelector('.body').textContent = pendingAI._body;
  lastAIBubble = pendingAI;
  autoScroll();
  playSentence(m.audio, m.text);
}
function setState(text, cls) {
  $('stateText').textContent = text;
  $('statePill').className = 'statePill ' + (cls || '');
  $('avatar').className = 'avatar ' + (cls === 'speaking' ? 'speaking' : '');
}

/* ================= 音频帧 / VAD ================= */
function handleAudioFrame({ pcm, level }) {
  if (!ws || ws.readyState !== 1) return;
  if (level < vad.noise * 2) vad.noise = vad.noise * 0.96 + level * 0.04;
  const thr = Math.max(500, vad.noise * 2.5 + 80);
  const loud = level > thr;
  // 音量条
  const bars = $('vu').children;
  const h = Math.min(26, 4 + level / 260);
  for (let i = 0; i < bars.length; i++) bars[i].style.height = (loud ? h * (0.6 + Math.random() * 0.7) : 4) + 'px';

  if (!micOn) { if (engine !== 'live' && vad.inUtt) { vad.inUtt = false; ws.send(JSON.stringify({ type: 'utt_end' })); } return; }

  if (engine === 'live') {
    // Live 模式：连续音频流直通 Gemini，VAD / 打断由服务端处理
    ws.send(pcm.buffer);
    return;
  }

  if (playing || playQueue.length > 0) {
    vad.barge = loud ? vad.barge + 1 : 0;
    if (vad.barge >= 5) {
      vad.barge = 0;
      stopPlayback();
      ws.send(JSON.stringify({ type: 'barge' }));
      setState('你打断了面试官，请讲', 'listening');
      addMsg('sys', '— 你打断了面试官 —');
    }
    return;
  }
  if (loud) {
    vad.speech++; vad.silence = 0;
    if (!vad.inUtt && vad.speech >= 2) {
      vad.inUtt = true; vad.uttFrames = 0;
      ws.send(JSON.stringify({ type: 'utt_start' }));
      if (curStatus.includes('识别')) setState('请讲…', 'listening');
    }
  } else {
    vad.speech = Math.max(0, vad.speech - 1);
    if (vad.inUtt) {
      vad.silence++;
      if (vad.silence >= 7) {
        vad.inUtt = false;
        ws.send(JSON.stringify({ type: 'utt_end' }));
        setState('识别中…', 'thinking');
        return;
      }
    }
  }
  if (vad.inUtt) {
    vad.uttFrames++;
    ws.send(pcm.buffer);
    if (vad.uttFrames >= 320) { vad.inUtt = false; ws.send(JSON.stringify({ type: 'utt_end' })); }
  }
}

/* ================= 播放 ================= */
function playSentence(b64, text) {
  playQueue.push(b64 ? { kind: 'buf', b64 } : { kind: 'tts', text });
  pumpPlayback();
}
async function pumpPlayback() {
  if (playing) return;
  const item = playQueue[0];
  if (!item) { if (!curStatus) setState('听你说', 'listening'); return; }
  playing = true;
  setState('面试官说话中 · 可打断', 'speaking');
  try {
    if (item.kind === 'buf') {
      const ab = Uint8Array.from(atob(item.b64), (c) => c.charCodeAt(0)).buffer;
      const buf = await audioCtx.decodeAudioData(ab.slice(0));
      await playBuf(buf);
    } else await speakLocal(item.text);
  } catch (e) { console.warn('play', e); }
  playing = false;
  playQueue.shift();
  pumpPlayback();
}
function playBuf(buf) {
  return new Promise((resolve) => {
    const s = audioCtx.createBufferSource();
    s.buffer = buf; s.connect(masterGain || audioCtx.destination);
    curSources.push(s);
    s.onended = () => { curSources = curSources.filter((x) => x !== s); resolve(); };
    s.start();
  });
}
function speakLocal(text) {
  return new Promise((resolve) => {
    if (!window.speechSynthesis) return resolve();
    const u = new SpeechSynthesisUtterance(text);
    u.lang = 'zh-CN'; u.rate = 1.05; u.onend = resolve; u.onerror = resolve;
    speechSynthesis.speak(u);
  });
}
function stopPlayback() {
  playQueue.length = 0;
  curSources.forEach((s) => { try { s.stop(); } catch {} });
  curSources = [];
  if (window.speechSynthesis) speechSynthesis.cancel();
  playing = false;
}

/* ================= Live 引擎：PCM 流无缝播放 ================= */
function playLiveChunk(b64) {
  if (!audioCtx) return;
  const bin = Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
  let i16;
  try { i16 = new Int16Array(bin.buffer, bin.byteOffset, bin.byteLength >> 1); } catch { return; }
  if (!i16.length) return;
  const buf = audioCtx.createBuffer(1, i16.length, 24000);
  const d = buf.getChannelData(0);
  for (let i = 0; i < i16.length; i++) d[i] = i16[i] / 32768;
  const now = audioCtx.currentTime;
  if (liveNext < now + 0.05) liveNext = now + 0.05;
  const s = audioCtx.createBufferSource();
  s.buffer = buf; s.connect(masterGain || audioCtx.destination);
  s.onended = () => {
    const ix = liveSrc.indexOf(s);
    if (ix >= 0) liveSrc.splice(ix, 1);
    if (!liveSrc.length && engine === 'live' && !curStatus) setState('听你说', 'listening');
  };
  s.start(liveNext);
  liveNext += buf.duration;
  liveSrc.push(s);
  setState('面试官说话中 · 可直接打断', 'speaking');
}
function stopLivePlayback() {
  liveSrc.forEach((s) => { try { s.stop(); } catch {} });
  liveSrc.length = 0;
  liveNext = 0;
}
function onAiDelta(text) {
  if (!pendingAI) pendingAI = addMsg('ai', '');
  pendingAI._body += text;
  pendingAI.querySelector('.body').textContent = pendingAI._body;
  lastAIBubble = pendingAI;
  autoScroll();
}

/* ================= 控件 ================= */
$('textSend').onclick = sendText;
$('textInput').addEventListener('keydown', (e) => { if (e.key === 'Enter') sendText(); });
function sendText() {
  const v = $('textInput').value.trim();
