# 复制为 .env 后填入真实值（.env 已被 .gitignore 排除，永不入库）
# Cloudflare / 任何托管平台的密钥请配置在对应平台的 Secrets 功能里，不要写进代码

# Gemini Live 引擎（Google AI Studio 免费领取）
GEMINI_KEY=
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Charon

# cascade 兜底引擎（可选；不填则 cascade 不可用）
LLM_BASE=https://api.example.com/v1
LLM_KEY=
LLM_MODEL=glm-5.3-flash

# whisper.cpp STT（cascade 用）
WHISPER_URL=http://127.0.0.1:8081/inference

# 单场面试时长上限（分钟），默认 15
INTERVIEW_MINUTES=15

# 服务端口
PORT=3100
